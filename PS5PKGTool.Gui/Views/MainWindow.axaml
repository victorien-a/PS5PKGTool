<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PS5PKGTool.Gui.ViewModels"
        x:Class="PS5PKGTool.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PS5 PKG Tool"
        Width="1100" Height="700"
        MinWidth="720" MinHeight="460">

  <DockPanel>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="10,8" Background="#1F1F1F">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Add folder..." Click="OnAddFolder" />
        <Button Content="Remove" Click="OnRemoveFolder"
                IsEnabled="{Binding #FolderList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Content="Scan" Click="OnScan" IsEnabled="{Binding CanScan}" />
        <Button Content="Cancel" Click="OnCancelScan" IsEnabled="{Binding IsScanning}" />
        <Separator />
        <Button Content="Convert..." Click="OnConvert" IsEnabled="{Binding HasSelection}" />
        <Button Content="Extract..." Click="OnExtract" IsEnabled="{Binding HasSelection}" />
        <Button Content="Build..." Click="OnBuild" />
        <Separator />
        <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding FormatFilter}"
                  ToolTip.Tip="Quick filter by format (adds a format: token to the search box)" />
        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding CategoryFilter}"
                  ToolTip.Tip="Quick filter by category (adds a category: token to the search box)" />
        <TextBox Width="320" PlaceholderText="Search (title:, id:, size:&gt;50GB, -exclude...)"
                 Text="{Binding SearchText}">
          <ToolTip.Tip>
            <StackPanel Spacing="2">
              <TextBlock Text="Search grammar:" FontWeight="SemiBold" />
              <TextBlock Text="Free text matches title/title ID/content ID/path." />
              <TextBlock Text="Fields: title: id: content: category: region: size: version: fw: feature: drm: path:" />
              <TextBlock Text="AND with spaces: title:zero fw:&gt;=6.00" />
              <TextBlock Text="OR within a token (no spaces around |): alpha|beta" />
              <TextBlock Text="Negate with -: -category:dlc" />
              <TextBlock Text="Comparisons: size:&gt;50GB  fw:&gt;=6.00" />
              <TextBlock Text="Quoted phrases: &quot;game of the year&quot;" />
            </StackPanel>
          </ToolTip.Tip>
        </TextBox>
      </StackPanel>
    </Border>

    <!-- Task queue: only takes space once there is something to show -->
    <Border DockPanel.Dock="Bottom" Padding="10,8" Background="#1A1A1A"
            BorderBrush="#2A2A2A" BorderThickness="0,1,0,0"
            DataContext="{Binding TaskQueue}"
            IsVisible="{Binding HasTasks}">
      <DockPanel MaxHeight="180">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Text="{Binding Status}" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Clear completed" Click="OnClearCompletedTasks" />
        </Grid>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TaskItemViewModel">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,3">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}"
                             Opacity="0.7" Margin="8,0" VerticalAlignment="Center" />
                  <Button Grid.Row="0" Grid.Column="2" Content="Cancel" Padding="8,2"
                          IsVisible="{Binding CanCancel}" Click="OnCancelTask" Tag="{Binding Id}" />
                  <Button Grid.Row="0" Grid.Column="3" Content="Retry" Padding="8,2"
                          IsVisible="{Binding CanRetry}" Click="OnRetryTask" Tag="{Binding Id}" />
                  <ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Minimum="0" Maximum="100"
                               Value="{Binding Percent}" Height="4" Margin="0,4,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="10,6" Background="#1F1F1F">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                     IsVisible="{Binding IsScanning}" />
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="220,4,*,4,320">

      <!-- Folders -->
      <DockPanel Grid.Column="0" Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Library folders" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox x:Name="FolderList" ItemsSource="{Binding Folders}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#2A2A2A" />

      <!-- Library -->
      <DataGrid Grid.Column="2" Margin="8"
                ItemsSource="{Binding Games}"
                SelectedItem="{Binding SelectedGame}"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="Auto" MinWidth="36" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:GameViewModel">
                <Grid Width="28" Height="28" Margin="2">
                  <Border Background="#2A2A2A" CornerRadius="3" />
                  <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="UniformToFill"
                         IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- Title takes the remaining space but keeps a floor, so widening the fixed
               columns to fit their headers cannot squeeze it away entirely. -->
          <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" MinWidth="160" />
          <DataGridTextColumn Header="Title ID" Binding="{Binding TitleId}" Width="Auto" MinWidth="90" />
          <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="Auto" MinWidth="70" />
          <DataGridTextColumn Header="Version" Binding="{Binding ContentVersion}" Width="Auto" MinWidth="70" />
          <DataGridTextColumn Header="FW" Binding="{Binding RequiredFirmware}" Width="Auto" MinWidth="55" />
          <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="Auto" MinWidth="80" />
        </DataGrid.Columns>
      </DataGrid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="#2A2A2A" />

      <!-- Details -->
      <ScrollViewer Grid.Column="4" Margin="8">
        <StackPanel Spacing="10">

          <TextBlock Text="Details" FontWeight="SemiBold" />

          <TextBlock Text="Select an item to see its details."
                     Opacity="0.6" TextWrapping="Wrap"
                     IsVisible="{Binding !HasSelection}" />

          <StackPanel Spacing="4"
                      IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HasSelection}"
                      DataContext="{Binding SelectedGame}">
            <Grid Width="96" Height="96" HorizontalAlignment="Left">
              <Border Background="#2A2A2A" CornerRadius="4" />
              <Image Source="{Binding Icon}" Width="96" Height="96" Stretch="Uniform"
                     IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding TitleId}" Opacity="0.7" />
            <TextBlock Text="{Binding ContentId}" Opacity="0.7" TextWrapping="Wrap" />
            <Separator Margin="0,6" />
            <TextBlock Text="{Binding Format, StringFormat='Format: {0}'}" />
            <TextBlock Text="{Binding ContentVersion, StringFormat='Version: {0}'}" />
            <TextBlock Text="{Binding RequiredFirmware, StringFormat='Firmware: {0}'}" />
            <TextBlock Text="{Binding SizeText, StringFormat='Size: {0}'}" />
            <TextBlock Text="{Binding Path}" Opacity="0.6" TextWrapping="Wrap" FontSize="11" />
          </StackPanel>

          <Separator IsVisible="{Binding HasSelection}" />

          <TextBlock Text="Files" FontWeight="SemiBold" IsVisible="{Binding HasSelection}" />
          <ItemsControl ItemsSource="{Binding SelectedGameFiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FileEntryViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                  <TextBlock Grid.Column="0" Text="{Binding Path}" FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11"
                             Opacity="0.6" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>

    </Grid>
  </DockPanel>
</Window>
